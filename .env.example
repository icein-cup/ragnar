OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333

# The reranker cross-encoder, served from the HOST so it can use Metal —
# Docker on macOS has no GPU access, and it is ~7x slower inside the
# container (10.34s vs 1.48s per 30 candidates on an M5 Pro). Start it with:
#     .venv/bin/python retrieval/rerank_server.py
# Set this EMPTY to score in-container on CPU instead. If it is set and the
# server is not running, reranking fails loudly rather than silently
# reverting to the slow path.
RERANKER_URL=http://host.docker.internal:8007

# Token cap per (query, chunk) pair sent to the reranker. A cross-encoder pads
# every pair in a batch to the longest sequence in it, so one oversized chunk
# makes all 30 candidates cost as if every one were that long (measured: 1.74s
# with a 1750-char longest chunk, 9.00s with a 6648-char one). 512 tokens
# truncates only genuine outliers -- this corpus's p99 chunk is ~500 tokens.
# Must match --max-length if you start rerank_server.py with an override, or
# the host and in-container paths score the same chunk differently.
RERANKER_MAX_LENGTH=512

# Optional. Silences the "unauthenticated requests to the HF Hub" warning
# and raises rate limits when downloading the reranker model. Create a free
# read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Ragas judge — an LLM judge for eval-only metrics (never used in the app).
# Points at an OpenAI-compatible endpoint. Ollama Cloud exposes one at
# https://ollama.com/v1 (note the /v1 — the bare https://ollama.com/api
# 404s under the OpenAI client).
RAGAS_JUDGE_BASE_URL=https://ollama.com/v1
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_MODEL=glm-5.2:cloud
