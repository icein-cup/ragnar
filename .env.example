OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333

# Optional. Silences the "unauthenticated requests to the HF Hub" warning
# and raises rate limits when downloading the reranker model. Create a free
# read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Ragas judge — an LLM judge for eval-only metrics (never used in the app).
# Points at an OpenAI-compatible endpoint. Ollama Cloud exposes one at
# https://ollama.com/v1 (note the /v1 — the bare https://ollama.com/api
# 404s under the OpenAI client).
RAGAS_JUDGE_BASE_URL=https://ollama.com/v1
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_MODEL=glm-5.2:cloud
